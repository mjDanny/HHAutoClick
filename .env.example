APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/app.db

HH_BASE_URL=https://api.hh.ru
HH_USER_AGENT=personal-hh-job-autopilot/0.1 (contact: example@example.com)
HH_ACCESS_TOKEN=
HH_RESUME_ID=
HH_LOGIN_CHECK_URL=https://hh.ru/applicant/resumes

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

AUTO_APPLY_ENABLED=false
DRY_RUN=true
MIN_SCORE_FOR_REVIEW=55
MIN_SCORE_FOR_AUTO_APPLY=88
MAX_APPLICATIONS_PER_DAY=5
APPLICATION_COOLDOWN_SECONDS=900

BROWSER_PROFILE_DIR=.local/browser-profile
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chromium
USE_OAUTH=false
USE_BROWSER_PROFILE=true
